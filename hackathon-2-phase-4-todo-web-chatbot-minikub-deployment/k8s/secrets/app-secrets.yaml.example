# Application Secrets Example
# DO NOT commit this file with real credentials to version control
# This is a template - copy to app-secrets.yaml and update values
#
# To create secret imperatively (RECOMMENDED):
#   kubectl create secret generic app-secrets \
#     --from-literal=database-url='postgresql://todouser:YOUR_PASSWORD@postgres-service:5432/tododb' \
#     --from-literal=jwt-secret='YOUR_JWT_SECRET_KEY_HERE' \
#     --from-literal=openai-api-key='sk-YOUR_OPENAI_API_KEY_HERE'
#
# To create from this file:
#   1. Copy this file: cp app-secrets.yaml.example app-secrets.yaml
#   2. Update all values below with base64 encoded secrets
#   3. Apply: kubectl apply -f k8s/secrets/app-secrets.yaml
#   4. NEVER commit app-secrets.yaml to git!
#
# To encode secrets to base64:
#   echo -n 'your-secret-value' | base64
#
# To decode base64 (for verification):
#   echo 'base64-encoded-value' | base64 -d

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: default
  labels:
    app: flowtask
    component: backend
type: Opaque
data:
  # PostgreSQL connection string
  # Format: postgresql://todouser:PASSWORD@postgres-service:5432/tododb
  # Example value: postgresql://todouser:securepassword123@postgres-service:5432/tododb
  # Base64 encoded example: cG9zdGdyZXNxbDovL3RvZG91c2VyOnNlY3VyZXBhc3N3b3JkMTIzQHBvc3RncmVzLXNlcnZpY2U6NTQzMi90b2RvZGI=
  database-url: cG9zdGdyZXNxbDovL3RvZG91c2VyOnNlY3VyZXBhc3N3b3JkMTIzQHBvc3RncmVzLXNlcnZpY2U6NTQzMi90b2RvZGI=

  # JWT Secret Key for token signing
  # MUST be strong random string (at least 32 characters)
  # Generate with: openssl rand -hex 32
  # Example value: your-secret-key-change-in-production
  # Base64 encoded example: eW91ci1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u
  jwt-secret: eW91ci1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u

  # OpenAI API Key for AI chatbot features
  # Get from: https://platform.openai.com/api-keys
  # Example value: sk-proj-abc123xyz789...
  # Base64 encoded example: c2stcHJvai1hYmMxMjN4eXo3ODk=
  openai-api-key: c2stcHJvai1hYmMxMjN4eXo3ODk=

---

# Security Best Practices:
#
# 1. NEVER commit secrets to version control
#    - Add k8s/secrets/*.yaml to .gitignore (already done)
#    - Only commit .example files with dummy values
#
# 2. Use strong passwords and secrets
#    - Database password: At least 16 characters, random
#    - JWT secret: At least 32 characters, use openssl rand -hex 32
#    - Rotate secrets regularly
#
# 3. Limit access to secrets
#    - Use Kubernetes RBAC to restrict secret access
#    - Only backend pods should have access to app-secrets
#
# 4. Encrypt secrets at rest
#    - Kubernetes encrypts secrets in etcd by default (if configured)
#    - For production: Enable encryption at rest in cluster
#
# 5. Use external secret managers (production)
#    - Sealed Secrets (encrypts secrets in git)
#    - External Secrets Operator (syncs from Vault, AWS Secrets Manager, etc.)
#    - SOPS (encrypts YAML files with PGP/KMS)
#
# 6. Audit secret access
#    - Enable Kubernetes audit logging
#    - Monitor secret read/write operations
#    - Alert on unusual access patterns

---

# Generating Strong Secrets:
#
# Database Password (16 characters):
#   openssl rand -base64 16
#
# JWT Secret (32 bytes = 64 hex characters):
#   openssl rand -hex 32
#
# Random string (32 characters):
#   cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1
#
# Base64 encode for Kubernetes:
#   echo -n 'your-secret' | base64

---

# Verifying Secrets in Cluster:
#
# List all secrets:
#   kubectl get secrets
#
# Describe secret (shows keys but not values):
#   kubectl describe secret app-secrets
#
# Get secret YAML (shows base64 encoded values):
#   kubectl get secret app-secrets -o yaml
#
# Decode specific key:
#   kubectl get secret app-secrets -o jsonpath='{.data.database-url}' | base64 -d
#
# Verify backend pod can read secrets:
#   kubectl exec -it <backend-pod> -- env | grep -E 'DATABASE_URL|JWT_SECRET_KEY|OPENAI_API_KEY'

---

# Updating Secrets:
#
# Option 1: Delete and recreate (recommended for kubectl create)
#   kubectl delete secret app-secrets
#   kubectl create secret generic app-secrets --from-literal=...
#   kubectl rollout restart deployment backend  # Restart pods to pick up new secret
#
# Option 2: Apply updated YAML
#   kubectl apply -f k8s/secrets/app-secrets.yaml
#   kubectl rollout restart deployment backend
#
# Option 3: Patch existing secret
#   kubectl patch secret app-secrets -p '{"data":{"jwt-secret":"NEW_BASE64_VALUE"}}'
#   kubectl rollout restart deployment backend

---

# Troubleshooting:
#
# Secret not found error:
#   - Check secret exists: kubectl get secret app-secrets
#   - Check namespace matches deployment: kubectl get secrets -n default
#
# Pod failing with "secret not found":
#   - Create secret before deploying pods
#   - Check secretKeyRef name and key match exactly
#
# Wrong password/connection errors:
#   - Verify base64 encoding is correct (no newlines)
#   - Use echo -n (no trailing newline) when encoding
#   - Decode and verify: kubectl get secret app-secrets -o jsonpath='{.data.database-url}' | base64 -d
#
# Pods not picking up secret changes:
#   - Secrets are mounted at pod creation time
#   - Must restart pods: kubectl rollout restart deployment backend
