# PostgreSQL Secret Example
# DO NOT commit this file with real credentials to version control
# This is a template - copy to postgres-secret.yaml and update values
#
# To create secret imperatively (recommended):
#   kubectl create secret generic postgres-secret \
#     --from-literal=password='YOUR_SECURE_PASSWORD_HERE'
#
# To create from this file:
#   1. Copy this file: cp postgres-secret.yaml.example postgres-secret.yaml
#   2. Update the password value below with base64 encoded password
#   3. Apply: kubectl apply -f k8s/secrets/postgres-secret.yaml
#   4. NEVER commit postgres-secret.yaml to git!
#
# To encode password to base64:
#   echo -n 'your-password' | base64

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: default
  labels:
    app: postgres
    component: database
type: Opaque
data:
  # Base64 encoded password
  # Example: 'securepassword123' encoded = c2VjdXJlcGFzc3dvcmQxMjM=
  # Replace with your own: echo -n 'YOUR_PASSWORD' | base64
  password: c2VjdXJlcGFzc3dvcmQxMjM=
