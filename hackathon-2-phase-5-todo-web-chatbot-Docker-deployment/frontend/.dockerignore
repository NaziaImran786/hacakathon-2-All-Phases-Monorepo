# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next/
out/

# Environment files (secrets should not be in images)
.env
.env.*
*.env.local
*.env.development
*.env.test
*.env.production

# Git files
.git/
.gitignore
.gitattributes

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing and coverage
coverage/
.nyc_output/
*.cover

# Documentation
*.md
docs/

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Docker files (no need to include in image)
Dockerfile
.dockerignore
docker-compose.yml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Vercel deployment files
.vercel/

# TypeScript cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# Kubernetes manifests (not needed in image)
k8s/
helm/
*.yaml
*.yml

# Package manager files (already handled in multi-stage build)
yarn.lock
pnpm-lock.yaml
